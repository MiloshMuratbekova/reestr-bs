# ============================================================
# Реестр БС — конфигурация бэкенда (сервер 10.10.31.35)
# Скопировать в .env и заполнить секреты.
# ============================================================

APP_NAME="Реестр БС"
APP_ENV=production
DEBUG=false
API_PREFIX=/api

# --- HTTP сервер ---
HOST=0.0.0.0
PORT=8020
WORKERS=4

# Каталог собранного фронтенда: приложение раздаёт интерфейс само,
# nginx в закрытом контуре не нужен. Пусть указывается от каталога backend.
FRONTEND_DIST=../frontend/dist

# --- CORS ---
# Интерфейс и API работают на одном адресе, поэтому CORS нужен только
# для режима разработки с отдельным Vite-сервером.
CORS_ORIGINS=["http://10.10.31.35:8020","http://localhost:5173"]

# --- ClickHouse (192.168.122.45:8123, HTTP интерфейс) ---
CLICKHOUSE_HOST=192.168.122.45
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=ai_doa
# Пароль задайте здесь на сервере либо через Настройки в интерфейсе.
# В репозиторий он не попадает.
# Только чтение: система не создаёт таблиц в ведомственной базе
CLICKHOUSE_READONLY=true
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=AFM_6_TEST
CLICKHOUSE_TIMEOUT=1800
CLICKHOUSE_MAX_EXECUTION_TIME=1800
CLICKHOUSE_MAX_MEMORY_USAGE=32000000000
CLICKHOUSE_VERIFY_SSL=false

# --- PostgreSQL (локально на бэкенд-сервере 10.10.31.35) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=bs_registry
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bs_registry

# --- AI Qwen через Ollama (192.168.97.9:11434) ---
OLLAMA_BASE_URL=http://192.168.97.9:11434
# Имя модели ровно как в Ollama — через дефис. Проверить список моделей:
#   curl http://192.168.97.9:11434/api/tags
OLLAMA_MODEL=doai-vision2:latest
# Модель на 122B параметров отвечает медленно — таймаут увеличен
OLLAMA_TIMEOUT=600
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=16384

# --- Безопасность ---
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Первичный администратор (создаётся при первом старте)
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=CHANGE_ME

# --- База ClickHouse, в которой алгоритмы создают таблицы результатов ---
REGISTRY_DATABASE=AFM_6_TEST

# --- Справочники ClickHouse, используемые при сборке итоговой таблицы ---
DICT_COMPANIES=AFM_2_1_TEST.AFM_2_1_9
DICT_PERSONS=AFM_2_1_TEST.AFM_2_1_10
DICT_OWNERSHIP=AFM_2_1.AFM_2_1_8
DICT_DOCUMENTS=AFM_2_1.AFM_2_1_59
DICT_SHARES=AFM_6_TEST.AFM_6_1_5_1
TBL_FOUNDERS=AFM_2_1_TEST.AFM_2_1_5_1
TBL_DIRECTORS=AFM_2_1_TEST.AFM_2_1_6_1

TIMEZONE=Asia/Almaty

# --- Логи ---
LOG_LEVEL=INFO
LOG_DIR=./logs
