# =============================================================================
# Реестр БС — конфигурация запуска на сервере 10.10.31.35
#
# При сборке комплекта секреты генерируются автоматически, и файл .env
# уже лежит внутри бандла заполненным. Этот файл — образец на случай,
# если конфигурацию нужно пересоздать вручную.
# =============================================================================

# --- Публикуемый порт ------------------------------------------------------
# Проверьте, что порт свободен: ss -tlnp | grep 8020
# Уже заняты соседними проектами: 8090 — drop-detector, 8081 — fm-monitor.
WEB_PORT=8020

# --- PostgreSQL (контейнер внутри compose, наружу не публикуется) ----------
# Это отдельная база проекта. С PostgreSQL, установленным на самом сервере
# (10.10.31.35:5432), она не пересекается: другой порт и своя сеть.
POSTGRES_USER=bs_registry
POSTGRES_DB=bs_registry
POSTGRES_PASSWORD=

# --- Безопасность ----------------------------------------------------------
# openssl rand -base64 64 | tr -d '\n'
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Первичный администратор создаётся при первом запуске
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=

# --- ClickHouse (192.168.122.45:8123) --------------------------------------
CLICKHOUSE_HOST=192.168.122.45
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=AFM_6_TEST
CLICKHOUSE_TIMEOUT=1800
CLICKHOUSE_MAX_EXECUTION_TIME=1800
CLICKHOUSE_MAX_MEMORY_USAGE=32000000000

# --- ИИ Qwen через Ollama (192.168.97.8:11434) -----------------------------
OLLAMA_BASE_URL=http://192.168.97.8:11434
# Имя модели ровно как в Ollama. Проверить: curl http://192.168.97.8:11434/api/tags
OLLAMA_MODEL=qwen3.5-122b
# ollama — нативный API; openai — OpenAI-совместимый
LLM_API_KIND=ollama
OLLAMA_TIMEOUT=600
OLLAMA_TEMPERATURE=0.2
# Задаётся явно: по умолчанию Ollama берёт 4096 и молча обрезает всё длиннее
OLLAMA_NUM_CTX=16384
LLM_MAX_TOKENS=2048
LLM_CONCURRENCY=2
# Держать модель в памяти: иначе выгружается через 5 минут и первый запрос
# после паузы ждёт повторной загрузки — выглядит как таймаут
LLM_KEEP_ALIVE=30m

# --- Лимиты выборок --------------------------------------------------------
MAX_ROWS_PER_QUERY=1000
MAX_ROWS_PER_CLIENT=50000

# --- Приложение ------------------------------------------------------------
APP_ENV=production
DEBUG=false
API_PREFIX=/api
LOG_LEVEL=INFO
TIMEZONE=Asia/Almaty

# --- Справочники ClickHouse ------------------------------------------------
REGISTRY_DATABASE=AFM_6_TEST
DICT_COMPANIES=AFM_2_1_TEST.AFM_2_1_9
DICT_PERSONS=AFM_2_1_TEST.AFM_2_1_10
DICT_OWNERSHIP=AFM_2_1.AFM_2_1_8
DICT_DOCUMENTS=AFM_2_1.AFM_2_1_59
DICT_SHARES=AFM_6_TEST.AFM_6_1_5_1
TBL_FOUNDERS=AFM_2_1_TEST.AFM_2_1_5_1
TBL_DIRECTORS=AFM_2_1_TEST.AFM_2_1_6_1
